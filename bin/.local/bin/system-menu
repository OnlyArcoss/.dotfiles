#!/bin/bash

menu() {
  local prompt="$1"
  local options="$2"

  printf "%b" "$options" \
    | walker --dmenu --nosearch --width 280 -p "$prompt…" \
    2>/dev/null
}

show_main_menu() {
  case "$(menu 'Menu' \
" Update system
󰜉 Restart
󰐥 Poweroff
󰤄 Suspend
")" in
    *"Update system"*)
      kitty --class kitty-float --hold -e bash -c 'sudo pacman -Syu && yay -Syu && flatpak update'
      ;;
    *Restart*)
      systemctl reboot
      ;;
    *Poweroff*)
      systemctl poweroff
      ;;
    *Suspend*)
      systemctl suspend
      ;;
  esac
}

show_main_menu
